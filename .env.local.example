# Server-only (never prefix with NEXT_PUBLIC_)
SUPABASE_URL=https://api.walpulse.com
SUPABASE_SERVICE_ROLE_KEY=

# Browser / SSR Auth (portal clientes) — same project as SUPABASE_URL
NEXT_PUBLIC_SUPABASE_URL=https://api.walpulse.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Demo page — cliente "Demo User" / label website-demo (plaintext never in git)
WALPULSE_DEMO_API_KEY=
# UUID of walpulse.clientes row for Demo User (poll scope)
WALPULSE_DEMO_CLIENTE_ID=

# Demo abuse controls — Upstash Redis (rate limit by IP)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Demo abuse controls — Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Temporary test bypass (1/true) — hides widget + skips siteverify. Re-enable ASAP.
NEXT_PUBLIC_DEMO_SKIP_TURNSTILE=

# Public site origin (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.walpulse.com
